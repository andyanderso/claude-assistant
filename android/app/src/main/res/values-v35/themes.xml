<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps edge-to-edge by default. This app keeps the classic layout
         (content below the status bar) so nothing hides under the system bars. -->
    <style name="Theme.Copilot" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlActivated">@color/teal</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
